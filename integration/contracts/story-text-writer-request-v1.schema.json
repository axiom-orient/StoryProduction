{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/text-writer-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "task",
    "allowedEffect",
    "providerProgram",
    "providerArguments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "story.text-writer-request/1"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "task": {
      "type": "object"
    },
    "allowedEffect": {
      "const": "return_one_text_candidate"
    },
    "providerProgram": {
      "type": "string",
      "minLength": 1
    },
    "providerArguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
