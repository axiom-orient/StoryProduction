{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/text-writer-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "status",
    "content",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "story.text-writer-result/1"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "outcome_unknown"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "content": {
            "type": "null"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
