{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NarrativeCourier",
  "version": "0.12.1",
  "identifier": "app.narrative-courier.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NarrativeCourier",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' data: blob:; frame-src 'self' data: blob:; object-src 'self' data: blob:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../skills/sts/": "skills/sts/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
