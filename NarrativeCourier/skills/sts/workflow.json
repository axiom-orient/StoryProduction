{
  "schema_version": 3,
  "domain_id": "sts",
  "domain_version": "4.3.0",
  "description": "Canonical STS generation contract: synopsis fidelity compiler with lossless source coverage, adaptation-pressure preflight, typed source authority, stateful scene execution, source-blind round-trip verification and Human release.",
  "stages": [
    {
      "id": "source",
      "label": "Source",
      "description": "Recover and approve the source truth.",
      "outputs": [
        "output/step_00_source_ir.md"
      ]
    },
    {
      "id": "architecture",
      "label": "Architecture",
      "description": "Define audience/presentation/causal adaptation contract.",
      "outputs": [
        "output/step_01_screenplay_contract.md",
        "output/step_02_narrative_map.md"
      ]
    },
    {
      "id": "execution",
      "label": "Execution System",
      "description": "Define cinematic space and character state.",
      "outputs": [
        "output/step_03_cinematic_system.md",
        "output/step_04_character_states.md"
      ]
    },
    {
      "id": "treatment",
      "label": "Treatment",
      "description": "Write the causal whole-film treatment.",
      "outputs": [
        "output/step_05_treatment.md"
      ]
    },
    {
      "id": "scenes",
      "label": "Scene IR",
      "description": "Build stateful SCN transition contracts.",
      "outputs": [
        "output/step_06_scene_blueprint.md"
      ]
    },
    {
      "id": "draft",
      "label": "Draft",
      "description": "Write bounded context parts and assemble the first draft.",
      "outputs": [
        "output/step_07_first_draft.md"
      ]
    },
    {
      "id": "revision",
      "label": "Revision",
      "description": "Diagnose and apply Human-authorized dependency-aware repairs.",
      "outputs": [
        "output/step_08_diagnosis.md",
        "output/final_screenplay.md"
      ]
    },
    {
      "id": "verification",
      "label": "Verification",
      "description": "Source-blind reconstruction and independent source comparison.",
      "outputs": [
        "output/step_08_recovered_screenplay_ir.md",
        "output/step_08_verification.md"
      ]
    },
    {
      "id": "final",
      "label": "Release",
      "description": "Human release of verified screenplay.",
      "outputs": [
        "output/final_screenplay.md"
      ]
    }
  ],
