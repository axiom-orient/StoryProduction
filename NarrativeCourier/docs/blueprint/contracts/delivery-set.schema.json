{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/contracts/delivery-set.schema.json",
  "title": "DeliverySet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "narrative_package_sha256",
    "delivery_request_sha256",
    "director_plan_sha256",
    "asset_index_sha256",
    "status",
    "deliveries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "set_id": {
      "type": "string",
      "minLength": 1
    },
    "narrative_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "director_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "NEEDS_REVIEW",
        "BLOCKED"
      ]
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/delivery"
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "WARN",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_request_id",
        "artifact",
        "backend_id",
        "backend_fingerprint",
        "lineage_refs",
        "verification",
        "status"
      ],
      "properties": {
        "output_request_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "backend_id": {
          "type": "string",
          "minLength": 1
        },
        "backend_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "lineage_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(SRC|REL|GAP|CON|SCN)-[A-Za-z0-9_-]+$"
          },
          "minItems": 1
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic",
            "visual",
            "technical"
          ],
          "properties": {
            "semantic": {
              "$ref": "#/$defs/layer"
            },
            "visual": {
              "$ref": "#/$defs/layer"
            },
            "technical": {
              "$ref": "#/$defs/layer"
            }
          }
        },
        "status": {
          "enum": [
            "PASS",
            "NEEDS_REVIEW",
            "BLOCKED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "semantic": {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    }
                  },
                  "technical": {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    }
                  },
                  "visual": {
                    "properties": {
                      "status": {
                        "enum": [
                          "PASS",
                          "NOT_APPLICABLE"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "verification": {
                    "properties": {
                      "semantic": {
                        "properties": {
                          "status": {
                            "const": "FAIL"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "verification": {
                    "properties": {
                      "visual": {
                        "properties": {
                          "status": {
                            "const": "FAIL"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "verification": {
                    "properties": {
                      "technical": {
                        "properties": {
                          "status": {
                            "const": "FAIL"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "BLOCKED"
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "NEEDS_REVIEW"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deliveries": {
            "contains": {
              "properties": {
                "status": {
                  "const": "BLOCKED"
                }
              }
            },
            "minContains": 1
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "deliveries": {
              "minItems": 1,
              "items": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "status": {
              "const": "PASS"
            }
          }
        },
        "else": {
          "properties": {
            "status": {
              "const": "NEEDS_REVIEW"
            }
          }
        }
      }
    }
  ]
}
