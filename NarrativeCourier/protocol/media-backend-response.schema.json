{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/protocol/media-backend-response.schema.json",
  "title": "MediaBackendResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "operation",
    "ok",
    "result",
    "error",
    "error_class"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "DESCRIBE",
        "MATERIALIZE",
        "RENDER"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_class": {
      "enum": [
        "TRANSIENT",
        "PERMANENT",
        "CANCELED",
        null
      ]
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "version",
        "fingerprint",
        "operations",
        "formats",
        "limits"
      ],
      "properties": {
        "backend_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MATERIALIZE",
              "RENDER"
            ]
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "HTML",
              "PNG",
              "WEBP",
              "SVG",
              "PDF",
              "MP4",
              "WEBM",
              "JSON",
              "OTIO",
              "PPTX"
            ]
          }
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "source_request_id",
        "kind",
        "path",
        "sha256",
        "mime",
        "size_bytes",
        "backend_id",
        "backend_fingerprint"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "source_request_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "IMAGE",
            "VECTOR",
            "AUDIO",
            "VIDEO",
            "FONT",
            "MODEL_3D",
            "DATA"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "backend_id": {
          "type": "string",
          "minLength": 1
        },
        "backend_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "materialize_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "render_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "backend_id",
        "backend_fingerprint"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "backend_id": {
          "type": "string",
          "minLength": 1
        },
        "backend_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          },
          "error": {
            "type": "null"
          },
          "error_class": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "error_class": {
            "enum": [
              "TRANSIENT",
              "PERMANENT",
              "CANCELED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "operation": {
            "const": "DESCRIBE"
          }
        },
        "required": [
          "ok",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/descriptor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "operation": {
            "const": "MATERIALIZE"
          }
        },
        "required": [
          "ok",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/materialize_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "operation": {
            "const": "RENDER"
          }
        },
        "required": [
          "ok",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/render_result"
          }
        }
      }
    }
  ]
}
