{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/protocol/media-backend-request.schema.json",
  "title": "MediaBackendRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "operation",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "DESCRIBE",
        "MATERIALIZE",
        "RENDER"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "describe_payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "materialize_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "director_plan",
        "asset_request_id",
        "workspace"
      ],
      "properties": {
        "director_plan": {
          "$ref": "#/$defs/artifact_ref"
        },
        "asset_request_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "render_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "director_plan",
        "asset_index",
        "output_request_id",
        "workspace"
      ],
      "properties": {
        "director_plan": {
          "$ref": "#/$defs/artifact_ref"
        },
        "asset_index": {
          "$ref": "#/$defs/artifact_ref"
        },
        "output_request_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "DESCRIBE"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/describe_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "MATERIALIZE"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/materialize_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "RENDER"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/render_payload"
          }
        }
      }
    }
  ]
}
