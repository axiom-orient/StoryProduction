{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schema/reviewed-synopsis-handoff/v1",
  "title": "GeultuReviewedSynopsisHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "handoff_id",
    "project_id",
    "source_revision",
    "synopsis_path",
    "synopsis_sha256",
    "title",
    "language",
    "approval"
  ],
  "properties": {
    "schema_id": { "const": "geultu.dev/reviewed-synopsis-handoff/v1" },
    "schema_version": { "const": 1 },
    "handoff_id": { "type": "string", "pattern": "^gsh_[0-9a-f]{64}$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_revision": { "type": "integer", "minimum": 1 },
    "synopsis_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$))(?!.*:).+$"
    },
    "synopsis_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "decision",
        "synopsis_sha256",
        "source_revision",
        "approved_at_ms"
      ],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "decision": { "const": "APPROVE" },
        "synopsis_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_revision": { "type": "integer", "minimum": 1 },
        "approved_at_ms": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
