{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/contracts/text-storyboard-v1.schema.json",
  "title": "text-storyboard-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "taskHash",
    "baseHash",
    "scenes",
    "changeSummary",
    "assumptions",
    "openQuestions",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nvc.text-storyboard/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativePackageSha256",
        "sceneMapSha256",
        "releaseBundleSha256"
      ],
      "properties": {
        "narrativePackageSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sceneMapSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "releaseBundleSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "taskHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "intent",
        "panels"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^SCN-[0-9]{3,}$"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "panelId",
              "composition",
              "staging",
              "sourceRefs",
              "soundNotes",
              "transition"
            ],
            "properties": {
              "panelId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "composition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "staging": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "semanticId",
                    "entryHash"
                  ],
                  "properties": {
                    "semanticId": {
                      "type": "string",
                      "pattern": "^semantic\\.[A-Za-z0-9._-]+$"
                    },
                    "entryHash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 10000
              },
              "soundNotes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "transition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 1,
          "maxItems": 1000
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenes",
        "changeSummary",
        "assumptions",
        "openQuestions"
      ],
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256
        }
      }
    }
  }
}
