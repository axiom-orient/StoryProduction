{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/contracts/text-storyboard-review-v1.schema.json",
  "title": "text-storyboard-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "boardHash",
    "decision",
    "reviewer",
    "note",
    "reviewedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nvc.text-storyboard-review/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativePackageSha256",
        "sceneMapSha256",
        "releaseBundleSha256"
      ],
      "properties": {
        "narrativePackageSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sceneMapSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "releaseBundleSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "boardHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "note": {
      "type": "string",
      "maxLength": 16384
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
