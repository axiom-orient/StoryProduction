{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-courier.local/contracts/narrative-scene-map/v1.schema.json",
  "title": "NarrativeSceneMap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "narrative_id", "screenplay_sha256", "scene_ir_sha256", "scenes"],
  "properties": {
    "schema_version": { "const": 1 },
    "map_id": { "type": "string", "minLength": 1 },
    "narrative_id": { "type": "string", "minLength": 1 },
    "screenplay_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scene_ir_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "order",
        "heading",
        "setting",
        "location",
        "time_of_day",
        "time_of_day_label",
        "silent",
        "characters",
        "action",
        "dialogue",
        "asset_requirements"
      ],
      "properties": {
        "scene_id": { "type": "string", "pattern": "^SCN-[0-9]{3,}$" },
        "order": { "type": "integer", "minimum": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "setting": { "enum": ["INT", "EXT", "INT/EXT", "I/E"] },
        "location": { "type": "string", "minLength": 1 },
        "time_of_day": { "enum": ["dawn", "morning", "noon", "day", "afternoon", "dusk", "night"] },
        "time_of_day_label": { "type": "string", "minLength": 1 },
        "silent": { "type": "boolean" },
        "characters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "action": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dialogue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character", "line"],
            "properties": {
              "character": { "type": "string", "minLength": 1 },
              "line": { "type": "string", "minLength": 1 }
            }
          }
        },
        "asset_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "description", "source"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
