{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-asset-compiler.local/visual-brief.schema.json",
  "title": "VisualBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "narrative_function",
    "emotional_intent",
    "first_read",
    "focal_hierarchy",
    "composition",
    "lighting",
    "color",
    "materials",
    "atmosphere",
    "environment_rules",
    "continuity",
    "avoid"
  ],
  "properties": {
    "narrative_function": {
      "type": "string",
      "minLength": 1
    },
    "first_read": {
      "type": "string",
      "minLength": 1
    },
    "focal_hierarchy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "camera_angle",
        "perspective",
        "lens_behavior",
        "focus_depth",
        "subject_placement",
        "depth_layers",
        "negative_space"
      ],
      "properties": {
        "framing": {
          "type": "string"
        },
        "camera_angle": {
          "type": "string"
        },
        "perspective": {
          "type": "string"
        },
        "subject_placement": {
          "type": "string"
        },
        "depth_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_space": {
          "type": "string"
        },
        "lens_behavior": {
          "type": "string"
        },
        "focus_depth": {
          "type": "string"
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivation",
        "direction",
        "quality",
        "contrast",
        "color_relationship"
      ],
      "properties": {
        "motivation": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "contrast": {
          "type": "string"
        },
        "color_relationship": {
          "type": "string"
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette_role",
        "dominant",
        "accent",
        "value_structure"
      ],
      "properties": {
        "palette_role": {
          "type": "string"
        },
        "dominant": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_structure": {
          "type": "string"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emotional_intent": {
      "type": "string",
      "minLength": 1
    },
    "atmosphere": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
