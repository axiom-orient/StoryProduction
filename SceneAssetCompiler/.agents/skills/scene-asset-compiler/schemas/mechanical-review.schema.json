{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MechanicalReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_no",
    "created_at",
    "status",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "attempt_no": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "WARN",
              "FAIL"
            ]
          },
          "message": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "layer_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
