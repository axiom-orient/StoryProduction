{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-asset-compiler.local/contracts/scene-asset-release-request/v1.schema.json",
  "title": "SceneAssetReleaseRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "createdAt", "projectionReceiptPath", "assets", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "projectionReceiptPath": { "type": "string", "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "kind", "rights", "sourceRegionId", "sourceArtifact", "runtimeDerivative"],
        "properties": {
          "assetId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$" },
          "kind": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/kind" },
          "rights": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/rights" },
          "sourceRegionId": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/sourceRegionId" },
          "sourceArtifact": { "$ref": "#/$defs/sourceArtifactRef" },
          "runtimeDerivative": {
            "allOf": [
              { "$ref": "#/$defs/artifactRef" },
              { "properties": { "mime": { "enum": ["image/png", "image/jpeg", "image/webp"] } } }
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mime", "sizeBytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mime": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceArtifactRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "description": "The declared MIME must match the file extension and detected signature. PSD/PSB source provenance uses image/vnd.adobe.photoshop and an 8BPS versioned header.",
          "properties": {
            "mime": { "enum": ["image/png", "image/jpeg", "image/webp", "image/vnd.adobe.photoshop"] }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "requirementType", "sceneEntityId", "assetId", "kind", "rights", "sourceRegionId"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^(CHARACTER_SPRITE|ENVIRONMENT_PLATE|PROP_CUTOUT|SHOT_KEYFRAME):[A-Za-z][A-Za-z0-9._:-]{1,127}$" },
        "requirementType": { "enum": ["CHARACTER_SPRITE", "ENVIRONMENT_PLATE", "PROP_CUTOUT", "SHOT_KEYFRAME"] },
        "sceneEntityId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$" },
        "assetId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$" },
        "kind": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/kind" },
        "rights": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/rights" },
        "sourceRegionId": { "$ref": "scene-asset-pack-v2.schema.json#/$defs/sourceRegionId" },
        "allowedUse": { "type": "string", "minLength": 1 },
        "crop": { "$ref": "#/$defs/crop" }
      }
    },
    "crop": {
      "type": "object",
      "description": "Pixel rectangle in the source artifact. All four values are JSON integers; x and y are zero-based coordinates and width and height are positive dimensions.",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
