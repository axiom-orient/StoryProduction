{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/animatic-assets-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packHash",
    "packetHash",
    "decision",
    "reviewer",
    "note",
    "reviewedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sac.animatic-assets-review/1"
    },
    "packHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "packetHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "note": {
      "type": "string",
      "maxLength": 8192
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
