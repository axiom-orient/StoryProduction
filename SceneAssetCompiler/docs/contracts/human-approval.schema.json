{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanApproval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reviewer",
    "approved_at",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "APPROVED"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
