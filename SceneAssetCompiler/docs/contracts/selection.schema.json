{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovedSelection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_no",
    "approved_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "attempt_no": {
      "type": "integer"
    },
    "approved_at": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "source_path",
          "run_path",
          "sha256",
          "mime",
          "size_bytes"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "run_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "role": {
            "enum": [
              "PRIMARY",
              "PREVIEW"
            ]
          }
        }
      }
    }
  }
}
