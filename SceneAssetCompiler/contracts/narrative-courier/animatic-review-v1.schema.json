{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/animatic-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planHash",
    "source",
    "decision",
    "reviewer",
    "note",
    "reviewedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nvc.animatic-review/1"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativePackageSha256",
        "sceneMapSha256",
        "releaseBundleSha256"
      ],
      "properties": {
        "narrativePackageSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sceneMapSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "releaseBundleSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "note": {
      "type": "string",
      "maxLength": 8192
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
