{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/animatic-plan-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "boardHash",
    "boardReviewHash",
    "fps",
    "canvas",
    "assets",
    "panels",
    "openQuestions",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nvc.animatic-plan/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativePackageSha256",
        "sceneMapSha256",
        "releaseBundleSha256"
      ],
      "properties": {
        "narrativePackageSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sceneMapSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "releaseBundleSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "boardHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "boardReviewHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fps": {
      "enum": [
        12,
        24,
        30,
        60
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "background": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "width",
          "height",
          "alpha",
          "brief"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "alpha": {
            "enum": [
              "opaque",
              "cutout"
            ]
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sceneId",
          "panelId",
          "durationFrames",
          "camera",
          "layers",
          "captions"
        ],
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "panelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36000
          },
          "camera": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frame",
                "x",
                "y",
                "scalePerMille",
                "easing"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 35999
                },
                "x": {
                  "type": "integer",
                  "minimum": -8192,
                  "maximum": 8192
                },
                "y": {
                  "type": "integer",
                  "minimum": -8192,
                  "maximum": 8192
                },
                "scalePerMille": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8000
                },
                "easing": {
                  "enum": [
                    "linear",
                    "easeInOut",
                    "hold"
                  ]
                }
              }
            }
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layerId",
                "depthPerMille",
                "poses",
                "motion"
              ],
              "properties": {
                "layerId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "depthPerMille": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000
                },
                "poses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "frame",
                      "assetId"
                    ],
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 35999
                      },
                      "assetId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      }
                    }
                  }
                },
                "motion": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "frame",
                      "x",
                      "y",
                      "scalePerMille",
                      "easing",
                      "rotationMilliDeg",
                      "opacityPerMille"
                    ],
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 35999
                      },
                      "x": {
                        "type": "integer",
                        "minimum": -8192,
                        "maximum": 8192
                      },
                      "y": {
                        "type": "integer",
                        "minimum": -8192,
                        "maximum": 8192
                      },
                      "scalePerMille": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8000
                      },
                      "easing": {
                        "enum": [
                          "linear",
                          "easeInOut",
                          "hold"
                        ]
                      },
                      "rotationMilliDeg": {
                        "type": "integer",
                        "minimum": -360000,
                        "maximum": 360000
                      },
                      "opacityPerMille": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      }
                    }
                  }
                }
              }
            }
          },
          "captions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "captionCues": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cueId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "semanticId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 35999
                },
                "endFrame": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 36000
                },
                "startUtf16": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16000
                },
                "endUtf16": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16000
                }
              },
              "required": [
                "cueId",
                "semanticId",
                "startFrame",
                "endFrame",
                "startUtf16",
                "endUtf16"
              ]
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "captionStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {
          "type": "integer",
          "minimum": 14,
          "maximum": 42
        },
        "maxLines": {
          "const": 2
        },
        "bandHeight": {
          "type": "integer",
          "minimum": 40,
          "maximum": 128
        },
        "fadeFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "required": [
        "fontSize",
        "maxLines",
        "bandHeight",
        "fadeFrames"
      ]
    }
  }
}
