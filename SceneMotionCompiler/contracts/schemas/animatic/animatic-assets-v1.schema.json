{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-production.local/contracts/animatic-assets-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetHash",
    "assets",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sac.animatic-assets/1"
    },
    "packetHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "path",
          "sha256",
          "width",
          "height",
          "alpha",
          "provenance"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "alpha": {
            "enum": [
              "opaque",
              "cutout"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executor",
              "source"
            ],
            "properties": {
              "executor": {
                "enum": [
                  "codex-imagegen",
                  "scene-provider-v2",
                  "user-supplied"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
