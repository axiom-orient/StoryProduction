{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-asset-compiler.local/contracts/visual-reference-pack-v1",
  "title": "visual-reference-pack-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sceneGraphHash",
    "sourceNarrativeSha256",
    "directorPlanSha256",
    "continuityBibleSha256",
    "entityReferences",
    "storyboardFrames",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "VisualReferencePack"
    },
    "sceneGraphHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceNarrativeSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "directorPlanSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "continuityBibleSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entityReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "role",
          "images",
          "invariants"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "role": {
            "enum": [
              "CHARACTER",
              "ENVIRONMENT",
              "PROP"
            ]
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "view",
                "artifact"
              ],
              "properties": {
                "view": {
                  "enum": [
                    "front",
                    "threeQuarter",
                    "profile",
                    "fullBody",
                    "expression",
                    "establishing",
                    "detail"
                  ]
                },
                "artifact": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "mime"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "mime": {
                      "enum": [
                        "image/png",
                        "image/jpeg",
                        "image/webp"
                      ]
                    }
                  }
                }
              }
            },
            "minItems": 1
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "storyboardFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotId",
          "artifact",
          "referenceEntityIds"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "mime"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "mime": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            }
          },
          "referenceEntityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
