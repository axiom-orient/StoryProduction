{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-motion-compiler.local/contracts/trackb/narrative-authority/v2",
  "title": "TrackBNarrativeAuthority v2",
  "schemaVersion": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "narrativeId",
    "sourceRevision",
    "sourceRefs",
    "story",
    "characters",
    "environments",
    "shots",
    "meaningItems",
    "authorityHash"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "authorityId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "narrativeId": { "type": "string", "pattern": "^narrative\\.[A-Za-z0-9._:-]{1,127}$" },
    "sourceRevision": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvcReleaseBundleHash",
        "narrativePackageHash",
        "narrativeSceneMapHash",
        "projectionReceiptHash",
        "sceneGraphHash",
        "sourceSemanticManifestHash",
        "semanticManifestHash"
      ],
      "properties": {
        "nvcReleaseBundleHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "narrativePackageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "narrativeSceneMapHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "projectionReceiptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sceneGraphHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceSemanticManifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "semanticManifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["premise", "theme", "setting"],
      "properties": {
        "premise": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" },
        "theme": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" },
        "setting": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characterId", "name"],
        "properties": {
          "characterId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environmentId", "name"],
        "properties": {
          "environmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "sceneId", "ordinal"],
        "properties": {
          "shotId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "sceneId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "ordinal": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
        }
      }
    },
    "meaningItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meaningId", "semanticRef", "shotId", "kind", "sourceText"],
        "properties": {
          "meaningId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "semanticRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semanticId", "entryHash"],
            "properties": {
              "semanticId": { "type": "string", "pattern": "^semantic\\.[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "entryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          },
          "shotId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "kind": { "type": "string", "enum": ["dialogue", "action", "emotion", "lightingTransition", "cameraMovement"] },
          "sourceText": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" }
        }
      }
    },
    "authorityHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
