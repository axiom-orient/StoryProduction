{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectorPreset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "preset_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+/[0-9]+\\.[0-9]+$"
    },
    "semantic_affinities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_grammar": {
      "type": "object"
    },
    "motion_grammar": {
      "type": "object"
    },
    "camera_grammar": {
      "type": "object"
    },
    "typography_grammar": {
      "type": "object"
    },
    "transition_grammar": {
      "type": "object"
    },
    "sound_grammar": {
      "type": "object"
    },
    "supported_motion_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "LAYERED_2_5D",
          "RIGGED_2D",
          "STOP_MOTION",
          "GEN_I2V",
          "GEN_T2V",
          "SCENE_3D",
          "HYBRID"
        ]
      }
    },
    "negative_defaults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "preset_id",
    "semantic_affinities",
    "visual_grammar",
    "motion_grammar",
    "camera_grammar",
    "typography_grammar",
    "transition_grammar",
    "sound_grammar",
    "supported_motion_modes",
    "negative_defaults"
  ]
}
