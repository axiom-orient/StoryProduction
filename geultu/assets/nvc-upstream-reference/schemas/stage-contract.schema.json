{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageContract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stage_id": {
      "type": "string",
      "pattern": "^S(0[0-9]|1[0-2])_[A-Z0-9_]+$"
    },
    "version": {
      "type": "string"
    },
    "artifact_owner": {
      "type": "string"
    },
    "executor_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DET",
          "LLM",
          "VLM",
          "GEN",
          "PROC",
          "HUMAN",
          "HYBRID"
        ]
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "StageInput",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "schema",
          "required"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "StageOutput",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "schema"
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "soft_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RetryPolicy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "max_repairs"
      ]
    },
    "next": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Next",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_pass": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_fail": {
          "type": "string"
        }
      },
      "required": [
        "on_pass",
        "on_fail"
      ]
    },
    "substeps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "StageSubstep",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "executor_class": {
            "type": "string",
            "enum": [
              "DET",
              "LLM",
              "VLM",
              "GEN",
              "PROC",
              "HUMAN",
              "HYBRID"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hard_gate": {
            "type": "string",
            "minLength": 1
          },
          "failure_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "step_id",
          "purpose",
          "executor_class",
          "inputs",
          "outputs",
          "hard_gate",
          "failure_codes"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "stage_id",
    "version",
    "artifact_owner",
    "executor_classes",
    "inputs",
    "outputs",
    "preconditions",
    "hard_gates",
    "soft_metrics",
    "failure_codes",
    "retry_policy",
    "next",
    "substeps"
  ]
}
