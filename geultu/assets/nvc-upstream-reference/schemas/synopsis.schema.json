{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynopsisArtifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "planning_provenance"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string"
    },
    "must_keep": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "artifact_id",
    "purpose",
    "text",
    "source_hash"
  ]
}
