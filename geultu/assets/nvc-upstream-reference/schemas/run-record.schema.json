{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "PASS",
        "FAIL_RETRYABLE",
        "BLOCKED_UPSTREAM",
        "NEEDS_REVIEW",
        "TERMINAL_FAIL"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "stage_id",
    "attempt",
    "inputs",
    "outputs",
    "status",
    "started_at",
    "ended_at",
    "failures",
    "metrics"
  ]
}
