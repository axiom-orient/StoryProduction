{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evaluation_id": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "hard_gate_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvalCheck",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "semantic",
              "continuity",
              "cinematic",
              "motion",
              "technical",
              "rights"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NEEDS_REVIEW"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "check_id",
          "category",
          "result",
          "confidence",
          "expected",
          "observed",
          "evidence"
        ]
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "./failure.schema.json"
      }
    }
  },
  "required": [
    "evaluation_id",
    "artifact_id",
    "hard_gate_status",
    "checks",
    "failures"
  ]
}
