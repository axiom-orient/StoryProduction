{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/narrative_design.v2.schema.json",
  "title": "narrative_design artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "world": {
      "type": "object"
    },
    "image_system": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "characters",
    "world",
    "image_system"
  ]
}
