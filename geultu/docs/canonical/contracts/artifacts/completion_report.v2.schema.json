{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/completion_report.v2.schema.json",
  "title": "completion_report artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "genre_contract_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "blocking_findings": {
      "type": "array",
      "maxItems": 0
    },
    "verdict": {
      "const": "pass"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "genre_contract_ref",
    "requirements",
    "blocking_findings",
    "verdict"
  ]
}
