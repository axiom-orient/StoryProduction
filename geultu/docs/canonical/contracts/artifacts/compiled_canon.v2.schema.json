{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/compiled_canon.v2.schema.json",
  "title": "compiled_canon artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "facts",
    "prohibitions",
    "source_digest"
  ]
}
