{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/craft_input_plan.v2.schema.json",
  "title": "craft_input_plan artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "adapter_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "declared_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "prompt_pack_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "adapter_ref",
    "declared_inputs",
    "prompt_pack_digest"
  ]
}
