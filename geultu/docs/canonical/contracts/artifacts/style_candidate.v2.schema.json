{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/style_candidate.v2.schema.json",
  "title": "style_candidate artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "profile_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "overlap_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "profile_ref",
    "instructions",
    "overlap_risk"
  ]
}
