{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/craft_strategy_binding.v2.schema.json",
  "title": "craft_strategy_binding artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "fallback_allowed": {
      "const": false
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "adapter_id",
    "adapter_version",
    "provider_id",
    "fallback_allowed"
  ]
}
