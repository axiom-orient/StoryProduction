{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/genre_contract.v2.schema.json",
  "title": "genre_contract artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "completion_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "genre",
    "required_sections",
    "completion_requirements"
  ]
}
