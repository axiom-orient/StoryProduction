{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/revision_directive.v2.schema.json",
  "title": "revision_directive artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "source_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "source_ref",
    "operations",
    "reason"
  ]
}
