{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/author_review.v2.schema.json",
  "title": "author_review artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "accept",
        "revise",
        "pivot",
        "reject"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "verdict",
    "findings"
  ]
}
