{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/rights_report.v2.schema.json",
  "title": "rights_report artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pass",
        "needs_review",
        "fail"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "commercial_use_allowed": {
      "type": "boolean"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "status",
    "sources",
    "commercial_use_allowed"
  ]
}
