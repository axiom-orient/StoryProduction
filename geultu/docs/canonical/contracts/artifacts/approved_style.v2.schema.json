{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/approved_style.v2.schema.json",
  "title": "approved_style artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "style_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "profile_ref": {
      "$ref": "../runtime/artifact-ref.schema.json"
    },
    "approval": {
      "$ref": "../runtime/approval-decision.schema.json"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "style_ref",
    "profile_ref",
    "approval"
  ]
}
