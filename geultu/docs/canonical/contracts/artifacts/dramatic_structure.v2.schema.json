{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/dramatic_structure.v2.schema.json",
  "title": "dramatic_structure artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "acts_or_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "causal_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "acts_or_sections",
    "causal_edges"
  ]
}
