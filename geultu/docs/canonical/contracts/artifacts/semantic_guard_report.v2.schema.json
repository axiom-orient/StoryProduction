{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/artifacts/semantic_guard_report.v2.schema.json",
  "title": "semantic_guard_report artifact body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "../runtime/artifact-ref.schema.json"
      },
      "uniqueItems": true
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "meaning_preserved": {
      "type": "boolean"
    },
    "protected_spans_preserved": {
      "type": "boolean"
    }
  },
  "required": [
    "api_version",
    "source_refs",
    "source_digest",
    "candidate_digest",
    "meaning_preserved",
    "protected_spans_preserved"
  ]
}
