{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geultu.dev/schemas/runtime/artifact-ref.v1.schema.json",
  "title": "Exact artifact reference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "request_spec",
        "normalized_request",
        "source_bundle",
        "rights_report",
        "canon",
        "compiled_canon",
        "style_corpus",
        "normalized_style_corpus",
        "style_profile",
        "style_candidate",
        "style_comparison",
        "approved_style",
        "genre_selection",
        "genre_contract",
        "craft_strategy_binding",
        "craft_input_plan",
        "verified_prompt_pack",
        "story_diagnosis",
        "dramatic_structure",
        "narrative_design",
        "treatment_scene_plan",
        "frozen_draft_plan",
        "unit_draft_set",
        "genre_draft",
        "craft_reviewed_draft",
        "structural_review",
        "semantic_review",
        "style_review",
        "refinement_diagnosis",
        "polish_patch",
        "semantic_guard_report",
        "polished_draft",
        "author_review",
        "revision_directive",
        "revised_draft",
        "revision_recheck",
        "pivot_decision",
        "completion_report",
        "text_master",
        "synopsis_master",
        "geultu_story_package",
        "visual_profile",
        "source_segments",
        "visual_beat_plan",
        "scene_map",
        "cut_plan",
        "layout_plan",
        "shot_plan",
        "asset_manifest",
        "reference_grammar",
        "rough_board",
        "board_review",
        "lineart_control",
        "lineart_master",
        "lineart_review",
        "tone_plan",
        "tone_master",
        "lettered_master",
        "still_master",
        "still_proof",
        "approved_still",
        "layer_manifest",
        "occlusion_repaired_layers",
        "layer_proof",
        "motion_plan",
        "html_projection",
        "runtime_proof",
        "approved_visual",
        "visual_master",
        "nvc_validated_package",
        "nvc_story_ir",
        "nvc_meaning_spec",
        "nvc_director_ir",
        "nvc_adaptation_ir",
        "nvc_scene_ir",
        "nvc_shot_ir",
        "nvc_render_ir",
        "nvc_timeline_ir",
        "nvc_materialized_assets",
        "nvc_shot_clips",
        "nvc_draft_master",
        "nvc_evaluation_report",
        "nvc_master_package",
        "approval_decision",
        "execution_receipt",
        "provider_receipt"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "id",
    "kind",
    "revision",
    "digest"
  ]
}
