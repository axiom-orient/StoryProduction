{
  "$id": "https://geultu.dev/schema/text-master/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 50000000,
      "minLength": 1,
      "type": "string"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "type": "string"
    },
    "lineage": {
      "additionalProperties": false,
      "properties": {
        "canon": {
          "$ref": "artifact-ref.schema.json"
        },
        "genre": {
          "$ref": "artifact-ref.schema.json"
        },
        "previous_text_master": {
          "oneOf": [
            {
              "$ref": "artifact-ref.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviews": {
          "items": {
            "$ref": "artifact-ref.schema.json"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "artifact-ref.schema.json"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "style": {
          "$ref": "artifact-ref.schema.json"
        },
        "synopsis": {
          "$ref": "artifact-ref.schema.json"
        }
      },
      "required": [
        "synopsis",
        "style",
        "canon",
        "genre",
        "sources",
        "reviews"
      ],
      "type": "object"
    },
    "project_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "project_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_id": {
      "const": "geultu.dev/text-master/v1"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "work_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "work_id",
    "project_id",
    "project_revision",
    "language",
    "title",
    "content",
    "lineage"
  ],
  "title": "TextMaster v1",
  "type": "object"
}
